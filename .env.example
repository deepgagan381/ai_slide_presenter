# Copy to .env and fill in. Only DEEPGRAM_API_KEY is needed to run.

# Speech in and out. Without it the app still presents, but silently.
# https://deepgram.com
DEEPGRAM_API_KEY=

# Optional
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional. Only worth changing if these names have moved on.
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash